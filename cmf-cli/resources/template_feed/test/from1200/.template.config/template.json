{
  "$schema": "http://json.schemastore.org/template",
  "author": "Critical Manufacturing",
  "classifications": [
    "cli"
  ],
  "description": "Generate a new tests package",
  "name": "Tests Package (> MES 12)",
  "identity": "cmf-cli.new.tests12",
  "groupIdentity": "cmf-cli.new.tests12",
  "shortName": "tests12",
  // You can create the project using this short name instead of the one above.
  "tags": {
    "language": "C#",
    // Specify that this template is in C#.
    "type": "project"
  },
  "sourceName": "Tests.Package",
  // Will replace the string 'MyProject.StarterWeb' with the value provided via -n.
  "preferNameDirectory": true,
  "symbols": {
    "name": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package name",
      "displayName": "Package Name",
      "replaces": "<%= $CLI_PARAM_CustomPackageName %>"
    },
    "projectName": {
      "type": "parameter",
      "datatype": "string",
      "description": "The name of our project",
      "displayName": "Project Name",
      "replaces": "<%= $CLI_PARAM_ProjectName %>"
    },
    "packageVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package version",
      "displayName": "Package Version",
      "replaces": "<%= $CLI_PARAM_CustomPackageVersion %>"
    },
    "repositoryType": {
      "type": "parameter",
      "datatype": "string",
      "description": "The type of repository to scaffold",
      "displayName": "Repository Type",
      "replaces": "<%= $CLI_PARAM_RepositoryType %>",
      "fileRename": "%repositoryType%"
    },
    "Tenant": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_Tenant %>",
      "fileRename": "%Tenant%"
    },
    "Product": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_Product %>",
      "fileRename": "%Product%"
    },
    "Organization": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_Organization %>",
      "fileRename": "%Org%"
    },
    "MESVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_MESVersion %>"
    },
    "hostPerformanceTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "replaces": "<%= $CLI_PARAM_hostPerformanceTests %>"
    },
    "testScenariosNugetVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_TestScenariosNugetVersion %>"
    },
    "vmHostname": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "localhost",
      "replaces": "<%= $CLI_PARAM_vmHostname %>"
    },
    "RESTPort": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "443",
      "replaces": "<%= $CLI_PARAM_RESTPort %>"
    },
    "HTMLPort": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "443",
      "replaces": "<%= $CLI_PARAM_HTMLPort %>"
    },
    "IsSslEnabled": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "true",
      "replaces": "<%= $CLI_PARAM_IsSslEnabled %>"
    },
    "scheme": {
      "type": "generated",
      "generator": "switch",
      "replaces": "<%= $CLI_PARAM_Scheme %>",
      "parameters": {
        "datatype": "string",
        "cases": [
          {
            "condition": "IsSslEnabled",
            "value": "https"
          },
          {
            "condition": "!IsSslEnabled",
            "value": "http"
          }
        ]
      }
    },
    "idSegment": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_idSegment %>",
      "fileRename": "%idSegment%"
    },
    "localEnvRelativePath": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_localEnvRelativePath %>"
    },
    "output": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_output %>"
    },
    // versioned bits
    "targetFramework": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_TargetFramework %>"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!hostPerformanceTests)",
          "exclude": [
            "**/%Org%.%Product%.Tests.Performance/**"
          ]
        }
      ]
    }
  ]
}
