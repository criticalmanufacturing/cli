<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="cmf-local-lbos" value="Libs/LBOs/NetStandard/Packages" />
    <add key="CMF" value="<%= $CLI_PARAM_NuGetRegistry %>" protocolVersion="3" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources />
  <solution>
    <add key="disableSourceControlIntegration" value="true" />
  </solution>
</configuration>
