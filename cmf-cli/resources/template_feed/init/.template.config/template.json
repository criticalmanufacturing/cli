{
  "$schema": "http://json.schemastore.org/template",
  "author": "Critical Manufacturing",
  "classifications": [ "cli" ],
  "description": "Initialize a new repository",
  "name": "Initialize Repository",
  "identity": "cmf-cli.init",
  "groupIdentity": "cmf-cli.init",
  "shortName": "init", // You can create the project using this short name instead of the one above.
  "tags": {
    "language": "C#", // Specify that this template is in C#.
    "type": "project"
  },
  "sourceName": "init_", // Will replace the string 'MyProject.StarterWeb' with the value provided via -n.
  "preferNameDirectory": false,
  "symbols": {
    // this symbol renames any _TEMPLATE_.* removing the prefix
    "templateFileRename": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "fileRename": "_TEMPLATE_"
    },
    // arguments
    "projectName": {
      "type": "parameter",
      "datatype": "string",
      "description": "The name of our project",
      "displayName": "Project Name",
      "replaces": "<%= $CLI_PARAM_ProjectName %>"
    },
    "projectConfigV2": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "replaces": "<%= $CLI_PARAM_ProjectConfigV2 %>"
    },
    "projectConfigV1File": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ".project-config",
      "fileRename": ".project-config-v1"
    },
    "projectConfigV2File": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": ".project-config",
      "fileRename": ".project-config-v2"
    },
    "customPackageName": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package name",
      "displayName": "Package Name",
      "replaces": "<%= $CLI_PARAM_CustomPackageName %>"
    },
    "packageVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package version",
      "displayName": "Package Version",
      "replaces": "<%= $CLI_PARAM_CustomPackageVersion %>"
    },
    "deploymentDir": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_DeploymentDir %>",
      "defaultValue": ""
    },
    "repositoryType": {
      "type": "parameter",
      "datatype": "string",
      "description": "The type of repository to scaffold",
      "displayName": "Repository Type",
      "replaces": "<%= $CLI_PARAM_RepositoryType %>"
    },
    "baseLayer": {
      "type": "parameter",
      "datatype": "string",
      "description": "The layer to which this repo will be applied: Core or MES",
      "displayName": "Base Layer",
      "replaces": "<%= $CLI_PARAM_BaseLayer %>"
    },
    "deploymentDir-JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_DeploymentDir %>\"",
      "valueSource": "deploymentDir",
      "valueTransform": "jsonEncode"
    },
    "CIRepo": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "\"<%= $CLI_PARAM_CIRepo %>\""
    },
    "CIRepo-JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_CIRepo %>\"",
      "valueSource": "CIRepo",
      "valueTransform": "jsonEncode"
    },
    "CIRepo_MainBranch": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "CIRepo"
          },
          {
            "type": "const",
            "value": "development"
          }
        ],
        "separator": "\\"
      }
    },
    // seems like we can't get derived symbols from generated symbols, so we do a simple backslash escape via regex replace
    "CIRepo_MainBranch-JSON": {
      "type": "generated",
      "generator": "regex",
      "dataType": "string",
      "replaces": "<%= $CLI_PARAM_CIRepo_MainBranch %>",
      "parameters": {
        "source": "CIRepo_MainBranch",
        "steps": [
          {
            "regex": "\\\\",
            "replacement": "\\\\"
          }
        ]
      }
    },
    "DeliveredRepo": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_DeliveredRepo %>"
    },
    "DeliveredRepo-JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_DeliveredRepo %>\"",
      "valueSource": "DeliveredRepo",
      "valueTransform": "jsonEncode"
    },
    "DeliveredRepo_JSON": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "replaces": "\"<%= $CLI_PARAM_DeliveredRepo_JSON %>\"",
      "parameters": {
        "source": "DeliveredRepo-JSON",
        "steps": [
          {
            "regex": "^(.*)$",
            "replacement": "[$1]"
          },
          {
            "regex": "\\[",
            "replacement": "[\n        "
          },
          {
            "regex": "\\]",
            "replacement": "\n    ]"
          },
          {
            "regex": ",",
            "replacement": ",\n        "
          }
        ]
      }
    },
    "ReleaseRepos": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_ReleaseRepos %>"
    },
    "ReleaseRepos-JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_ReleaseRepos %>\"",
      "valueSource": "ReleaseRepos",
      "valueTransform": "jsonEncode"
    },
    "ReleaseRepos_JSON": {
      "type": "generated",
      "generator": "regex",
      "datatype": "string",
      "replaces": "\"<%= $CLI_PARAM_ReleaseRepos_JSON %>\"",
      "parameters": {
        "source": "ReleaseRepos-JSON",
        "steps": [
          {
            "regex": ";",
            "replacement": "\",\""
          },
          {
            "regex": "^(.*)$",
            "replacement": "[$1]"
          },
          {
            "regex": "\\[",
            "replacement": "[\n        "
          },
          {
            "regex": "\\]",
            "replacement": "\n    ]"
          },
          {
            "regex": ",",
            "replacement": ",\n        "
          }
        ]
      }
    },
    "MESVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_MESVersion %>"
    },
    "MESVersion-Feature": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "MESVersion",
      "replaces": "<%= $CLI_PARAM_MESVersion-Feature %>",
      "valueTransform": "versionToFeature"
    },
    "MESVersion-Major": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "MESVersion",
      "replaces": "<%= $CLI_PARAM_MESVersion-Major %>",
      "valueTransform": "versionToMajor"
    },
    "CLIVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_CLIVersion %>"
    },
    "CLIVersion-MajorRange": {
      "type": "derived",
      "datatype": "string",
      "valueSource": "CLIVersion",
      "replaces": "<%= $CLI_PARAM_CLIVersion-MajorRange %>",
      "valueTransform": "versionToMajorRange"
    },
    "DevTasksVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_DevTasksVersion %>"
    },
    "HTMLStarterVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_HTMLStarterVersion %>"
    },
    "yoGeneratorVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_YoGeneratorVersion %>"
    },
    "ngxSchematicsVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_NGXSchematicsVersion %>"
    },
    "nugetVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_NugetVersion %>"
    },
    "testScenariosNugetVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_TestScenariosNugetVersion %>"
    },

    // from infra
    "nugetRegistry": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_NuGetRegistry %>"
    },
    "npmRegistry": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_NPMRegistry %>"
    },
    "nugetRegistryUsername": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "", // if we don't get the value, clear the token
      "replaces": "<%= $CLI_PARAM_NuGetRegistryUsername %>"
    },
    "nugetRegistryPassword": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "", // if we don't get the value, clear the token
      "replaces": "<%= $CLI_PARAM_NuGetRegistryPassword %>"
    },
    "ISOLocation": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_ISOLocation %>",
      "defaultValue": ""
    },
    "ISOLocation_JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_ISOLocation_JSON %>\"",
      "valueSource": "ISOLocation",
      "valueTransform": "jsonEncode"
    },

    // from config
    "EnvironmentName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_EnvironmentName %>",
      "fileRename": "%EnvironmentName%"
    },
    "DefaultDomain": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": null
    },
    "DefaultDomain-JSON": {
      "type": "derived",
      "replaces": "\"<%= $CLI_PARAM_DefaultDomain %>\"",
      "valueSource": "DefaultDomain",
      "valueTransform": "jsonEncode"
    },
    "RESTPort": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_RESTPort %>"
    },
    "Tenant": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_Tenant %>"
    },
    "vmHostname": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_vmHostname %>"
    },
    "HTMLPort": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_HTMLPort %>"
    },
    "IsSslEnabled": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "replaces": "<%= $CLI_PARAM_IsSslEnabled %>"
    },
    "ReleaseEnvironmentConfig": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_ReleaseEnvironmentConfig %>"
    },
    // versioned bits
    "dotnetSDKVersion": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_DotnetSDKVersion %>"
    },
    "appId": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppId %>"
    },
    "appAuthor": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppAuthor %>"
    },
    "appName": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppName %>"
    },
    "appNameLowerNoSpaces": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppNameLowerNoSpaces %>"
    },
    "appDescription": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppDescription %>"
    },
    "appLicensedApplication": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppLicensedApplication %>"
    },
    "appIcon": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "replaces": "<%= $CLI_PARAM_AppIcon %>"
    },
    "AppEnvironmentConfig": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": null
    },
    "AppEnvironmentConfig-JSON": {
      "replaces": "\"<%= $CLI_PARAM_AppEnvironmentConfig %>\"",
      "type": "derived",
      "valueSource": "AppEnvironmentConfig",
      "valueTransform": "jsonEncode"
    }
  },
  "forms": {
    "versionToMajor": {
      "identifier": "replace",
      "pattern": "^(\\d+)\\.\\d+\\.\\d+\\.?\\d*(?:[-+].*)?$",
      "replacement": "$1"
    },
    "versionToMajorRange": {
      "identifier": "replace",
      "pattern": "^(\\d+)\\.\\d+\\.\\d+\\.?\\d*(?:[-+].*)?$",
      "replacement": "$1.x.x"
    },
    "versionToFeature": {
      "identifier": "replace",
      "pattern": "^(\\d+)\\.(\\d+)\\.\\d+\\.?\\d*(?:[-+].*)?$",
      "replacement": "$1.$2.x"
    },
    "stripQuotes": {
      "identifier": "replace",
      "pattern": "\"([^\"]*)\"",
      "replacement": "$1"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "appName == \"\"",
          "exclude": [
            "cmfapp.json",
            "app_deployment_manifest.xml",
            "assets/**",
            "assets/"
          ]
        },
        {
          "condition": "projectConfigV2",
          "exclude": [ ".project-config-v1.json" ]
        },
        {
          "condition": "!projectConfigV2",
          "exclude": [ ".project-config-v2.json" ]
        }
      ]
    }
  ]
}
