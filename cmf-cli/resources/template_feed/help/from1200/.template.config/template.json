{
  "$schema": "http://json.schemastore.org/template",
  "author": "Critical Manufacturing",
  "classifications": [
    "cli"
  ],
  "description": "Generate a new MkDocs help/documentation package",
  "name": "Help Package (MES 12 or later)",
  "identity": "cmf-cli.new.help12",
  "groupIdentity": "cmf-cli.new.help12",
  "shortName": "help12",
  "tags": {
    "language": "Markdown",
    "type": "project"
  },
  "sourceName": "Help.Package",
  "preferNameDirectory": true,
  "symbols": {
    "name": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package name",
      "displayName": "Package Name",
      "replaces": "<%= $CLI_PARAM_CustomPackageName %>"
    },
    "packageVersion": {
      "type": "parameter",
      "datatype": "string",
      "description": "The custom package version",
      "displayName": "Package Version",
      "replaces": "<%= $CLI_PARAM_CustomPackageVersion %>"
    },
    "Tenant": {
      "type": "parameter",
      "datatype": "string",
      "replaces": "<%= $CLI_PARAM_Tenant %>"
    }
  }
}