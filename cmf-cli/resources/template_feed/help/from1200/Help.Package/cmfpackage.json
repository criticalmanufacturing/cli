{
  "packageId": "<%= $CLI_PARAM_CustomPackageName %>",
  "version": "<%= $CLI_PARAM_CustomPackageVersion %>",
  "description": "Cmf Custom <%= $CLI_PARAM_ProjectName %> <%= $CLI_PARAM_CustomPackageName %> Package",
  "packageType": "Help",
  "targetLayer": "reference",
  "isInstallable": true,
  "isUniqueInstall": false,
  "contentToPack": [
    {
      "source": "site/**",
      "target": "site"
    },
    {
      "source": "docs/<%= $CLI_PARAM_ProjectName %>/**",
      "target": "docs/<%= $CLI_PARAM_ProjectName %>"
    }
  ]
}